{
  "niveles": [
    {
      "titulo": "Interpolación Lineal",
      "instruccion": "Calcule g(2) usando interpolación lineal con los puntos (1, 2) y (3, 6).",
      "tiempo": 600,
      "intro": [
        "g(x) = y0 + (y1 - y0) / (x1 - x0) · (x - x0)",
        "Datos:  x0=1  y0=2  x1=3  y1=6  x=2"
      ],
      "pasos": [
        {
          "titulo": "Paso 1. Sustituya los valores en la fórmula:",
          "filas": [
            ["g(x) =", {"in": 2}, "+"],
            ["(", {"in": 6}, "-", {"in": 2}, ")", "/", "(", {"in": 3}, "-", {"in": 1}, ")", "·", "(", {"in": 2}, "-", {"in": 1}, ")"]
          ]
        },
        {
          "titulo": "Paso 2. Resuelva las restas:",
          "filas": [
            ["g(x) =", {"in": 2}, "+", {"in": 4}, "/", {"in": 2}, "·", {"in": 1}]
          ]
        },
        {
          "titulo": "Paso 3. Calcule la pendiente y el producto:",
          "filas": [
            ["m = 4 / 2 =", {"in": 2}],
            ["m · (x - x0) = 2 · 1 =", {"in": 2}]
          ]
        },
        {
          "titulo": "Paso 4. Resultado final:",
          "filas": [
            ["g(2) = 2 + 2 =", {"in": 4}]
          ]
        }
      ]
    },
    {
      "titulo": "Eliminación de Gauss",
      "instruccion": "Resuelva el sistema 2x + y = 5, x + 3y = 10 mediante eliminación de Gauss.",
      "tiempo": 480,
      "intro": ["Sistema:  2x + y = 5   y   x + 3y = 10"],
      "pasos": [
        {
          "titulo": "Paso 1. Escriba la matriz aumentada [A | b]:",
          "filas": [
            [{"matriz": [[{"in": 2}, {"in": 1}, {"in": 5}], [{"in": 1}, {"in": 3}, {"in": 10}]]}]
          ]
        },
        {
          "titulo": "Paso 2. Aplique R2 = R2 - (1/2)·R1 (puede escribir 5/2 o 2.5):",
          "filas": [
            [{"matriz": [[2, 1, 5], [{"in": 0}, {"in": 2.5}, {"in": 7.5}]]}]
          ]
        },
        {
          "titulo": "Paso 3. Sustitución hacia atrás. Despeje y:",
          "filas": [
            ["y = 7.5 / 2.5 =", {"in": 3}]
          ]
        },
        {
          "titulo": "Paso 4. Despeje x:",
          "filas": [
            ["x = (5 - 1·3) / 2 =", {"in": 1}]
          ]
        }
      ]
    }
  ]
