{
  "titulo": "Bisección",
  "nivel": "Bisectriz",
  "generador": "biseccion",
  "tiempo": 1200,
  "decimales": 4,
  "instruccion": "Aproxime la raíz de {funcion} con el método de bisección a partir del intervalo [{a}, {b}].",
  "intro": [
    "{funcion}",
    "c = (a + b) / 2",
    "Si f(a)·f(c) < 0, la raíz está en [a, c]; si no, en [c, b].",
    "error = |c(i) - c(i-1)|; se detiene cuando error <= 0.001 (máximo 9 iteraciones).",
    "Escriba los resultados con 4 decimales."
  ],
  "pasos": [
    {
      "repetir": "iteraciones",
      "como": "it",
      "paso": {
        "titulo": "Paso {paso}. Iteración {num}: [a, b] = [{it.a}, {it.b}]",
        "filas": [
          [
            "c{num} = ({it.a} + {it.b}) / 2 =",
            {
              "in": "it.c",
              "tol": 0.0005
            }
          ],
          [
            "f(c{num}) = {it.texto_fc} =",
            {
              "in": "it.fc",
              "tol": "it.tol_fc"
            }
          ],
          {
            "si": "idx > 0",
            "fila": [
              "error = |c{num} - c{idx}| =",
              {
                "in": "it.error",
                "tol": 0.0005
              }
            ]
          },
          [
            "Nuevo intervalo: [",
            {
              "in": "it.a_nuevo",
              "tol": 0.0005
            },
            ",",
            {
              "in": "it.b_nuevo",
              "tol": 0.0005
            },
            "]"
          ]
        ]
      }
    },
    {
      "titulo": "Paso {paso}. Resultado:",
      "filas": [
        [
          "Raíz aproximada: x =",
          {
            "in": "raiz",
            "tol": 0.0005
          }
        ]
      ]
    }
  ]
}