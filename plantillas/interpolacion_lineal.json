{
  "titulo": "Interpolación Lineal",
  "generador": "interpolacion_lineal",
  "tiempo": 600,
  "decimales": 4,
  "instruccion": "Calcule g({x}) usando interpolación lineal con los valores de a = {a} y b = {b}",
  "intro": [
    "g(x) = ((f(b) - f(a)) / (b - a)) * (x - a) + f(a)",
    "error = |f(x) - g(x)|",
    "Datos:  {funcion}",
    "x = {x}",
    "f(x) = {f_x}",
    "a = {a}",
    "f(a) = {f_a}",
    "b = {b}",
    "f(b) = {f_b}"
  ],
  "pasos": [
    {
      "titulo": "Paso {paso}. Sustituya los valores en la fórmula:",
      "filas": [
        ["g(x) = ((", {"in": "f_b"}, " - ", {"in": "f_a"}, ") /"],
        ["(", {"in": "b"}, " - ", {"in": "a"}, ")) * "],
        ["(", {"in": "x"}, " - ", {"in": "a"}, ") + ", {"in": "f_a"}]
      ]
    },
    {
      "titulo": "Paso {paso}. Resuelve g(x):",
      "filas": [
        ["g(x) = (", {"in": "(f_b - f_a) / (b - a)", "tol": 0.001}, ") * (", {"in": "x - a"}, ") + ", {"in": "f_a"}],
        ["g(x) = ", {"in": "g_x", "tol": 0.001}]
      ]
    },
    {
      "titulo": "Paso {paso}. Sustituye los valores de la fórmula:",
      "filas": [
        ["error = |", {"in": "f_x", "decimales": 4}, " - ", {"in": "g_x", "decimales": 4, "tol": 0.001}, "|"]
      ]
    },
    {
      "titulo": "Paso {paso}. Resuelve el error:",
      "filas": [
        ["error = ", {"in": "error", "decimales": 4, "tol": 0.001}]
      ]
    }
  ]
}
