{
  "titulo": "Regla 3/8 de Simpson",
  "generador": "simpson_3_8",
  "tiempo": 900,
  "decimales": 4,
  "instruccion": "Aproxime la integral de {funcion} de {a} a {b} con la regla 3/8 de Simpson (n = 3 subintervalos).",
  "intro": [
    "I = (3h/8)·[f(x0) + 3·f(x1) + 3·f(x2) + f(x3)]",
    "h = (b - a) / 3",
    "Datos:  {funcion}",
    "a = {a}     b = {b}     n = {n}"
  ],
  "pasos": [
    {
      "titulo": "Paso {paso}. Calcule el ancho de cada subintervalo:",
      "filas": [
        [
          "h = ({b} - {par(a)}) / {n} =",
          {
            "in": "h"
          }
        ]
      ]
    },
    {
      "titulo": "Paso {paso}. Evalúe la función en cada punto (4 decimales):",
      "filas": [
        {
          "repetir": "puntos",
          "como": "p",
          "fila": [
            "x{p.i} = {p.x}     f(x{p.i}) = {p.texto} =",
            {
              "in": "p.valor"
            }
          ]
        }
      ]
    },
    {
      "titulo": "Paso {paso}. Agrupe los valores:",
      "filas": [
        [
          "Extremos: f(x0) + f(x3) =",
          {
            "in": "extremos",
            "tol": "tol_extremos"
          }
        ],
        [
          "Interiores: f(x1) + f(x2) =",
          {
            "in": "interiores",
            "tol": "tol_interiores"
          }
        ],
        [
          "Suma = extremos + 3 · interiores =",
          {
            "in": "suma",
            "tol": "tol_suma"
          }
        ]
      ]
    },
    {
      "titulo": "Paso {paso}. Calcule la integral:",
      "filas": [
        [
          "I = (3h / 8) · suma = (3 · {h} / 8) · suma =",
          {
            "in": "l",
            "tol": "tol_l"
          }
        ]
      ]
    }
  ]
}