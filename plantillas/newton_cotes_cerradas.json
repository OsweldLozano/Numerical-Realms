{
  "titulo": "Newton-Cotes Cerradas",
  "generador": "newton_cotes_cerradas",
  "tiempo": 900,
  "decimales": 4,
  "instruccion": "Aproxime la integral de {funcion} de {a} a {b} con la fórmula cerrada de Newton-Cotes de n = {n}.",
  "intro": [
    "I = h · c · [w0·f(x0) + w1·f(x1) + ... + wn·f(xn)]",
    "h = (b - a) / n",
    "Coeficientes para n = {n}:  c = {constante}    w = {pesos_texto}",
    "Datos:  {funcion}",
    "a = {a}     b = {b}     n = {n}"
  ],
  "pasos": [
    {
      "titulo": "Paso {paso}. Calcule el ancho de cada subintervalo:",
      "filas": [
        [
          "h = ({b} - {par(a)}) / {n} =",
          {
            "in": "h"
          }
        ]
      ]
    },
    {
      "titulo": "Paso {paso}. Evalúe la función en cada punto (4 decimales):",
      "filas": [
        {
          "repetir": "puntos",
          "como": "p",
          "fila": [
            "x{p.i} = {p.x}     f(x{p.i}) = {p.texto} =",
            {
              "in": "p.valor"
            }
          ]
        }
      ]
    },
    {
      "titulo": "Paso {paso}. Multiplique cada f(xi) por su coeficiente:",
      "filas": [
        {
          "repetir": "puntos",
          "como": "p",
          "fila": [
            "{p.peso} · f(x{p.i}) =",
            {
              "in": "p.producto",
              "tol": "p.tol"
            }
          ]
        },
        [
          "Suma de los productos =",
          {
            "in": "suma",
            "tol": "tol_suma"
          }
        ]
      ]
    },
    {
      "titulo": "Paso {paso}. Calcule la integral:",
      "filas": [
        [
          "I = h · c · suma = {h} · {constante} · suma =",
          {
            "in": "l",
            "tol": "tol_l"
          }
        ]
      ]
    }
  ]
}