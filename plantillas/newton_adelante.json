{
  "titulo": "Newton Hacia Adelante",
  "generador": "newton_adelante",
  "tiempo": 900,
  "decimales": 4,
  "instruccion": "Calcule g({x}) con el método de Newton hacia adelante usando la tabla de {n} puntos.",
  "intro": [
    "g(x) = y0 + s·Δy0 + s(s - 1)/2!·Δ²y0 + s(s - 1)(s - 2)/3!·Δ³y0 + ...",
    "s = (x - x0) / h",
    "Datos:  x = {x}",
    {"repetir": "tabla", "como": "p", "texto": "x{idx} = {p[0]}        y{idx} = {p[1]}"}
  ],
  "pasos": [
    {
      "titulo": "Paso {paso}. Verifique que los puntos estén igualmente espaciados:",
      "filas": [
        {"repetir": "h", "como": "hh", "fila": ["h{num} = {hh.x1} - {par(hh.x0)} =", {"in": "hh.hi"}]},
        ["Entonces h =", {"in": "s.h"}]
      ]
    },
    {
      "repetir": "ordenes", "como": "o",
      "paso": {
        "titulo": "Paso {paso}. Diferencias de orden {o.k} ({o.simbolo}):",
        "filas": [
          {"repetir": "o.valores", "como": "d", "fila": ["{d.etiqueta} = {d.y1} - {par(d.y0)} =", {"in": "d.valor"}]}
        ]
      }
    },
    {
      "titulo": "Paso {paso}. Calcule s:",
      "filas": [
        ["s = ({s.x} - {par(s.xi)}) / {s.h} =", {"in": "s.s"}]
      ]
    },
    {
      "titulo": "Paso {paso}. Calcule cada término (coeficiente · factor):",
      "filas": [
        {"repetir": "g_x.operacion", "como": "op", "fila": [
          "{op.simbolo} · {op.formula}:   coef. =", {"in": "op.coeficiente"},
          " factor =", {"in": "op.factor"},
          " término =", {"in": "op.valor", "tol": 0.005}
        ]}
      ]
    },
    {
      "titulo": "Paso {paso}. Sume los términos:",
      "filas": [
        ["g({x}) =", {"in": "g_x.valor", "tol": 0.01}]
      ]
    }
  ]
}
