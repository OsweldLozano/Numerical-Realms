{
  "titulo": "Falsa Posición",
  "nivel": "Falsa Posición",
  "generador": "falsa_posicion",
  "tiempo": 1200,
  "decimales": 4,
  "instruccion": "Aproxime la raíz de {funcion} con el método de falsa posición a partir del intervalo [{a}, {b}].",
  "intro": [
    "{funcion}",
    "x = a - f(a)·(b - a) / (f(b) - f(a))",
    "Si f(a)·f(x) < 0, la raíz está en [a, x]; si no, en [x, b].",
    "error = |x(i) - x(i-1)|; se detiene cuando error <= 0.001.",
    "Escriba los resultados con 4 decimales."
  ],
  "pasos": [
    {
      "repetir": "iteraciones",
      "como": "it",
      "paso": {
        "titulo": "Paso {paso}. Iteración {num}: [a, b] = [{it.a}, {it.b}]",
        "filas": [
          [
            "f(a) = {it.texto_fa} =",
            {
              "in": "it.fa",
              "tol": "it.tol_fa"
            }
          ],
          [
            "f(b) = {it.texto_fb} =",
            {
              "in": "it.fb",
              "tol": "it.tol_fb"
            }
          ],
          [
            "x{num} = a - f(a)·(b - a) / (f(b) - f(a)) =",
            {
              "in": "it.x",
              "tol": 0.0005
            }
          ],
          [
            "f(x{num}) = {it.texto_fx} =",
            {
              "in": "it.fx",
              "tol": "it.tol_fx"
            }
          ],
          {
            "si": "idx > 0",
            "fila": [
              "error = |x{num} - x{idx}| =",
              {
                "in": "it.error",
                "tol": 0.0005
              }
            ]
          },
          [
            "Nuevo intervalo: [",
            {
              "in": "it.a_nuevo",
              "tol": 0.0005
            },
            ",",
            {
              "in": "it.b_nuevo",
              "tol": 0.0005
            },
            "]"
          ]
        ]
      }
    },
    {
      "titulo": "Paso {paso}. Resultado:",
      "filas": [
        [
          "Raíz aproximada: x =",
          {
            "in": "raiz",
            "tol": 0.0005
          }
        ]
      ]
    }
  ]
}